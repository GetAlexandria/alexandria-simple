{
  "name": "@alexandria/pms-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "pnpm exec prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,mjs}\"",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@alexandria/library-card-resolver": "workspace:*",
    "@astrojs/react": "^4.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "astro": "^5.13.5",
    "effect": "^3.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
