{
  "name": "@alexandria/pms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pms": "src/cli/main.ts"
  },
  "scripts": {
    "format": "pnpm exec prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "test": "bun test",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^3.20.0"
  }
}
