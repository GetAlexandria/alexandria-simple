// DERIVED RENDERING — projected from brief.md §4 (the move graph) per
// studio/plays/PROJECTION.md. Do not hand-edit play logic here: edits land in
// the brief and re-derive (Protocol E blocks banking on drift).
digraph BackOfHouseWalk {
    graph [
        goal="Produce a draft product-knowledge library bundle — part-first bounded-context stub cards, an _index keystone story, the four operational reports, and the machine-readable sidecars — from an EL1 source manifest and an operator scope, fully detached; refuse loudly rather than emit a thin bundle when the manifest yields nothing scannable.",
        max_node_visits=8,
        stall_timeout="2h",
        default_fidelity="truncate"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    translate_search_prior [
        label="Translate the Basic Product Description into a search prior",
        prompt="@prompts/translate_search_prior.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    survey [
        label="Survey the source and pick the read ladder",
        prompt="@prompts/survey.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    pass1_events [
        label="Surface past-tense Domain Events, time-first",
        prompt="@prompts/pass1_events.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    pass2_carve [
        label="Carve bounded contexts and classify each noun",
        prompt="@prompts/pass2_carve.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    pass3_altitude [
        label="Tag each card's C4 altitude",
        prompt="@prompts/pass3_altitude.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    emit_bundle [
        label="Write the bundle, reports, and sidecars to disk",
        prompt="@prompts/emit_bundle.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    check_bundle [
        label="Cold-read the bundle and decide PASS / REPAIR / FREEZE",
        prompt="@prompts/check_bundle.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        fidelity="truncate",
        timeout="20m"
    ]

    acp_failed [
        shape=parallelogram,
        label="Fail the run loudly on ACP failure, survey refusal, or FREEZE",
        script="echo \"back-of-house-walk failed (ACP failure, survey refusal, or check_bundle FREEZE); refusing to emit a degraded bundle\" >&2; exit 1",
        timeout="1m"
    ]

    start -> translate_search_prior
    translate_search_prior -> survey
    translate_search_prior -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    survey -> pass1_events [weight=10]
    survey -> acp_failed [label="refuse"]
    survey -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    pass1_events -> pass2_carve
    pass1_events -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    pass2_carve -> pass3_altitude
    pass2_carve -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    pass3_altitude -> emit_bundle
    pass3_altitude -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    emit_bundle -> check_bundle
    emit_bundle -> acp_failed [label="three strikes", condition="context.internal.node_visit_count >= 3"]
    emit_bundle -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]

    check_bundle -> exit        [label="PASS", weight=10]
    check_bundle -> emit_bundle [label="REPAIR"]
    check_bundle -> acp_failed  [label="FREEZE"]
    check_bundle -> acp_failed  [label="ACP failed", condition="outcome!=succeeded"]
}
