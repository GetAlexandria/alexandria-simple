{
  "name": "@alexandria/factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "pnpm exec prettier --write \"src/**/*.ts\" \"*.json\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"*.json\"",
    "lint": "pnpm exec eslint src",
    "test": "bun test",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "watch:issues": "bun src/fabro-issue-watcher.ts",
    "watch:issues:once": "bun src/fabro-issue-watcher.ts --once"
  },
  "dependencies": {
    "effect": "^3.20.0"
  }
}
