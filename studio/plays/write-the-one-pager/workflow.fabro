// DERIVED RENDERING — projected from brief.md §4 (the move graph) per
// studio/plays/PROJECTION.md, 2026-06-16. Do not hand-edit play logic here:
// edits land in the brief and re-derive (Protocol E blocks banking on drift).
// PROVISIONAL — built for Director review in the studio (pre-Gate-1; the ▲
// decisions are in brief §4).
digraph WriteTheOnePager {
    graph [
        goal="Define what we're building and why on a banked problem brief: one analysis rendered twice — the one-pager (runtime/one-pager.md) and the spoken paragraph — every problem claim traceable to a brief entry, no generated sizing.",
        max_node_visits=12,
        stall_timeout="2h"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    orient [
        label="Orient - confirm the precondition",
        prompt="@prompts/orient.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    account [
        label="Account for the whole problem space",
        prompt="@prompts/account.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    gather_context [
        label="Gather the business context",
        prompt="@prompts/gather_context.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    define [
        label="Define one solution direction",
        prompt="@prompts/define.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    map_coverage [
        label="Map coverage and non-goals",
        prompt="@prompts/map_coverage.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    set_goals [
        label="Set goals and metrics",
        prompt="@prompts/set_goals.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    compose [
        label="Compose the one-pager",
        prompt="@prompts/compose.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    ground [
        label="Ground - mechanical checks",
        prompt="@prompts/ground.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    speak [
        label="Speak the introduction",
        prompt="@prompts/speak.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    word_check [
        shape=parallelogram,
        label="Word budget check (wc, ceiling 100)",
        script="n=$(wc -w < runtime/spoken-paragraph.md | tr -d ' '); if [ \"$n\" -le 100 ]; then echo \"WORDCOUNT_OK: $n words (ceiling 100)\"; else echo \"WORDCOUNT_OVER: $n words, $((n-100)) over (ceiling 100) - cut a thought, not compress one\"; fi",
        timeout="5m"
    ]

    self_check [
        label="The pause before speaking",
        prompt="@prompts/self_check.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="30m"
    ]

    cold_reader [
        label="Cold-reader comprehension gate",
        prompt="@prompts/cold_reader.md",
        backend="acp",
        acp.command=__AX_ACP_COMMAND_JSON__,
        timeout="20m"
    ]

    acp_failed [
        shape=parallelogram,
        label="Fail the run on ACP failure",
        script="echo \"ACP run failed; refusing to advance the play\" >&2; exit 1",
        timeout="1m"
    ]

    start -> orient
    orient -> account [label="Proceed", weight=10]
    orient -> exit    [label="Refuse"]
    orient -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    account -> gather_context
    account -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    gather_context -> define
    gather_context -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    define -> map_coverage
    define -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    map_coverage -> set_goals [label="Proceed", weight=10]
    map_coverage -> exit      [label="Escalate"]
    map_coverage -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    set_goals -> compose
    set_goals -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    compose -> ground
    compose -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    ground -> speak        [label="Pass", weight=10]
    ground -> compose      [label="Fix compose"]
    ground -> map_coverage [label="Fix coverage"]
    ground -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    speak -> word_check
    speak -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    word_check -> self_check [condition="command.output contains \"WORDCOUNT_OK\" || context.internal.node_visit_count >= 3"]
    word_check -> speak
    self_check -> cold_reader  [label="Release", weight=10]
    self_check -> compose      [label="Fix voice"]
    self_check -> map_coverage [label="Fix logic"]
    self_check -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
    cold_reader -> exit    [label="Done", weight=10]
    cold_reader -> compose [label="Confused"]
    cold_reader -> acp_failed [label="ACP failed", condition="outcome!=succeeded"]
}
